<% if User.current.logged? %>
<h3><%= l(:label_issue_ical_subscribe) %></h3>
<ul class="issue-ical-links">
  <li><%= link_to l(:label_issue_ical_my_issues), '#',
                  onclick: "showModal('issue-ical-modal-my', '640px'); return false;" %></li>
  <% if @project && User.current.allowed_to?(:view_issues, @project) %>
  <li><%= link_to l(:label_issue_ical_project_issues, project: @project.name), '#',
                  onclick: "showModal('issue-ical-modal-project', '640px'); return false;" %></li>
  <% end %>
</ul>
<%= render partial: 'issue_ical/modal',
           locals: { modal_id: 'issue-ical-modal-my',
                     title: "#{l(:label_issue_ical_subscribe)} - #{l(:label_issue_ical_my_issues)}",
                     trackers: Tracker.visible.sorted.to_a,
                     feed_url: ->(tracker) { my_issue_ical_url(format: 'ics', key: User.current.atom_key, **(tracker ? { tracker_id: tracker.id } : {})) } } %>
<% if @project && User.current.allowed_to?(:view_issues, @project) %>
<%= render partial: 'issue_ical/modal',
           locals: { modal_id: 'issue-ical-modal-project',
                     title: "#{l(:label_issue_ical_subscribe)} - #{l(:label_issue_ical_project_issues, project: @project.name)}",
                     trackers: @project.rolled_up_trackers(Setting.display_subprojects_issues?).to_a,
                     feed_url: ->(tracker) { project_issue_ical_url(@project, format: 'ics', key: User.current.atom_key, **(tracker ? { tracker_id: tracker.id } : {})) } } %>
<% end %>
<% end %>
