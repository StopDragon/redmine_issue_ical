<% closed_option = user.pref.issue_ical_closed %>
<p id="issue-ical-preferences">
  <label><%= l(:label_issue_ical_display) %></label>
  <% RedmineIssueIcal::UserPreferencePatch::CLOSED_OPTIONS.each do |option| %>
  <label class="block">
    <%= radio_button_tag 'pref[issue_ical_closed]', option, closed_option == option,
                         id: "pref_issue_ical_closed_#{option}" %>
    <%= l("label_issue_ical_display_#{option}") %>
  </label>
  <% end %>
</p>
